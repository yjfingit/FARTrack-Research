         response = self.output_window * pred_score_map
+        if getattr(self.params, 'risk_log_path', None):
+            # Logging is opt-in and occurs strictly after the unchanged response
+            # calculation.  It cannot affect the following box decision.
+            flat = response.detach().reshape(-1)
+            probabilities = torch.softmax(flat, dim=0)
+            entropy = -(probabilities * probabilities.clamp_min(1e-12).log()).sum()
+            top2 = torch.topk(flat, k=2).values
+            record = {
+                'frame': self.frame_id,
+                'response_entropy': float(entropy.cpu()),
+                'response_peak': float(top2[0].cpu()),
+                'response_margin': float((top2[0] - top2[1]).cpu()),
+            }
+            with open(self.params.risk_log_path, 'a', encoding='utf-8') as handle:
+                handle.write(json.dumps(record, sort_keys=True) + '\n')
         pred_boxes = self.network.box_head.cal_bbox(response, out_dict['size_map'], out_dict['offset_map'])
